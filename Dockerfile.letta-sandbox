# Letta Sandbox - Hardened Docker image for tool execution
#
# Build: docker build -t letta-sandbox:latest -f Dockerfile.letta-sandbox .
#
# Security defaults:
# - Non-root user (sandbox:1001)
# - No sudo
# - No Docker socket
# - Minimal packages
# - Read-only rootfs (enforced by container runtime, not image)
#
# The container is started with "sleep infinity" and tool code is
# injected via exec_run. The read-only rootfs + tmpfs /tmp are
# configured at container creation time in docker_sandbox.py.

FROM python:3.11-slim

# Create non-root user
RUN groupadd -g 1001 sandbox && \
    useradd -u 1001 -g sandbox -m -s /bin/bash sandbox

# Install minimal packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install pip packages commonly needed by agent tools
RUN pip install --no-cache-dir pydantic letta-client

# Set working directory
WORKDIR /tmp

# Run as non-root
USER sandbox

# No CMD — container is started with "sleep infinity" and
# tool code is injected via exec_run
